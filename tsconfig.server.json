{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-server",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": false,
    "baseUrl": ".",
    "paths": {
      "@backend/*": ["src/backend/*"],
      "@shared/*": ["src/shared/*"],
      "@api/*": ["api/*"]
    }
  },
  "include": ["src/backend", "src/shared", "api", "database/seeders"]
}
