generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// EDITH staff membership role (unchanged)
enum Role {
  SUPER_ADMIN
  ADMISSIONS_MANAGER
  COUNSELOR
  CONTENT_UPLOADER
  STUDENT
}

enum DegreeLevel {
  CERTIFICATE
  DIPLOMA
  BACHELORS
  MASTERS
  DOCTORATE
  OTHER
}

enum ProgramCategory {
  YOUNG_POST_GRADUATE
  POST_GRADUATE
  FELLOW_EXECUTIVE
  ADVANCED_MANAGEMENT
  CENTRE_OF_EXCELLENCE
}

enum ProgramStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProgramKind {
  COURSE
  FOUNDATION
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  DOCUMENT_VERIFICATION
  UNDER_REVIEW
  INTERVIEW
  DECISION_PENDING
  OFFERED
  REJECTED
  WAITLISTED
  FEE_REQUESTED
  ENROLLED
  PAYMENT_PENDING
  PAID
  LOCKED
  CHANGE_REQUESTED
}

enum CrmSyncStatus {
  PENDING
  SUCCESS
  FAILED
}

enum CrmSyncAction {
  UPSERT_LEAD
  SYNC_STATUS
  ENROLL_NOTIFY
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
  OVERDUE
  SUBMITTED
  ACTION_REQUIRED
  SUCCESS
}

enum PaymentProvider {
  MOCK
  RAZORPAY
  OFFLINE
  STRIPE
  UPI
}

enum PaymentType {
  FULL
  PARTIAL
}

enum SyllabusStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  CANCELLED
  COMPLETED
  DROPPED
}

enum AssignmentSubmissionStatus {
  DRAFT
  SUBMITTED
  PENDING
  GRADED
  LATE
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonContentType {
  RICH_TEXT
  VIDEO_URL
  EXTERNAL_LINK
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  BANNED
  DELETED
}

enum CertificateStatus {
  ACTIVE
  REVOKED
}


// --- Compass-ported enums ---

enum AnnouncementPriority {
  CRITICAL
  IMPORTANT
  INFO
}

enum BadgeCategory {
  ACHIEVEMENT
  SKILL
  COMMUNITY
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELLED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum CouponScope {
  GLOBAL
  SPECIFIC
}

enum CouponType {
  FIXED
  PERCENTAGE
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseType {
  SELF_PACED
  HYBRID
}

enum Currency {
  INR
  USD
  GBP
  EUR
  AUD
  CAD
}

enum EmailCategory {
  TRANSACTIONAL
  MARKETING
  NOTIFICATION
}

enum EmailLogStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  FAILED
  BOUNCED
}

enum GroupMessageType {
  TEXT
  FILE
  ANNOUNCEMENT
}

enum IpRuleType {
  BLOCKED_LOGIN
  BLOCKED_WEBSITE
  WHITELISTED
}

enum LessonType {
  VIDEO
  TEXT
  QUIZ
  ASSIGNMENT
}

enum McqGenerationStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum McqSource {
  AI_GENERATED
  MANUAL
}

enum MessageType {
  TEXT
  FILE
  IMAGE
  VOICE
}

enum NotificationPriority {
  HIGH
  NORMAL
  LOW
}

enum NotificationType {
  MESSAGE
  ANNOUNCEMENT
  COURSE
  ASSIGNMENT
  GRADE
  SYSTEM
}

enum OfferStatus {
  OFFERED
  TOKEN_PAID
  ADMITTED
  WITHDRAWN
}

enum TicketCategory {
  TECHNICAL
  BILLING
  CONTENT
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  SUBMITTED
  ACTION_REQUIRED
}

enum VoteType {
  UPVOTE
  DOWNVOTE
}


model Organization {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  logoUrl      String?
  primaryColor String   @default("#0F172A")
  timezone     String   @default("UTC")
  // Compass Domain marketing fields
  subtitle     String?
  description  String?
  icon         String?
  color        String?
  bgColor      String?
  gradient     String?
  heroImage    String?
  bio          String?
  marketing    Json?
  isPublished  Boolean  @default(false)
  order        Int      @default(0)
  school       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships      Membership[]
  campuses         Campus[]
  departments      Department[]
  programs         Program[]
  formDefinitions  FormDefinition[]
  applications     Application[]
  enrollments      Enrollment[]
  assignments      Assignment[]
  quizzes          Quiz[]
  certificates     Certificate[]
  crmSyncLogs      CrmSyncLog[]
  payments         Payment[]
  aiPluginSetting  AiPluginSetting?
  permissionRoles  PermissionRole[]
  announcements    Announcement[]
  audienceSegments AudienceSegment[]
  auditLogs        AuditLog[]
  badges           Badge[]
  bloomsAnalyses   BloomsAnalysis[]
  certificateTemplates CertificateTemplate[]
  cliftonAssessments CliftonAssessment[]
  conversations    Conversation[]
  coupons          Coupon[]
  courseMcqs       CourseMcq[]
  courseAssessmentAttempts CourseAssessmentAttempt[]
  emailCampaigns   EmailCampaign[]
  emailLogs        EmailLog[]
  emailTemplates   EmailTemplate[]
  forumCategories  ForumCategory[]
  groups           Group[]
  installments     Installment[]
  ipRules          IpRule[]
  lessonMcqs       LessonMcq[]
  notificationPreferences NotificationPreference[]
  paymentSettings  PaymentSettings?
  tickets          Ticket[]
  programOffers    ProgramOffer[]
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  password     String
  name         String
  // Compass profile
  tempEmail    String?
  phoneNumber  String?
  image        String?
  username     String?
  headline     String?
  bio          String?
  socials      Json?
  billingAddress Json?
  status       UserStatus @default(ACTIVE)
  isVerified   Boolean    @default(false)
  verifyToken  String?
  verifyTokenExpiry DateTime?
  lastActive   DateTime?
  resetPasswordToken String?
  resetPasswordExpires DateTime?
  tokenVersion Int        @default(0)
  theme        String     @default("system")
  careerPath   String?
  privacySettings Json?
  isPersonalizedAccount Boolean @default(false)
  gstWaived    Boolean    @default(false)
  permissionRoleId String?
  roleId       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  permissionRole       PermissionRole? @relation(fields: [permissionRoleId], references: [id])
  memberships          Membership[]
  applications         Application[] @relation("ApplicantApplications")
  enrollments          Enrollment[]
  events               ApplicationEvent[]
  documents            Document[]
  verifiedDocuments    Document[] @relation("DocumentVerifier")
  passwordResetTokens  PasswordResetToken[]
  lessonProgress       LessonProgress[]
  assignmentSubmissions AssignmentSubmission[]
  quizAttempts         QuizAttempt[]
  certificates         Certificate[]
  notifications        Notification[]
  announcementReads    AnnouncementRead[]
  authoredAnnouncements Announcement[] @relation("AnnouncementAuthor")
  userBadges           UserBadge[]
  conversationParticipants ConversationParticipant[]
  messages             Message[] @relation("MessageSender")
  forumThreads         ForumThread[] @relation("ThreadAuthor")
  forumReplies         ForumReply[] @relation("ReplyAuthor")
  forumVotes           ForumVote[]
  groupMessages        GroupMessage[] @relation("GroupMessageAuthor")
  groupMentions        GroupMessageMention[]
  userGroups           UserGroup[]
  tickets              Ticket[]
  ticketMessages       TicketMessage[]
  payments             Payment[] @relation("PaymentUser")
  programOffers        ProgramOffer[]
  cliftonAssessments   CliftonAssessment[]
  notificationPreference NotificationPreference?
  auditLogs            AuditLog[]
  courseAssessmentAttempts CourseAssessmentAttempt[]
  lessonMcqAttempts    LessonMcqAttempt[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Membership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           Role
  /// null means access never expires
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles        MembershipRole[]
  @@unique([organizationId, userId])
  @@index([userId])
  @@index([expiresAt])
}

/// Lets one membership hold several PermissionRoles at once. Kept separate from
/// Membership.role, which stays the single enum role that session checks read.
model MembershipRole {
  id               String   @id @default(cuid())
  membershipId     String
  permissionRoleId String
  assignedAt       DateTime @default(now())
  membership     Membership     @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permissionRole PermissionRole @relation(fields: [permissionRoleId], references: [id], onDelete: Cascade)
  @@unique([membershipId, permissionRoleId])
  @@index([permissionRoleId])
}

model Campus {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String?
  city           String?
  country        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programs     Program[]
  @@index([organizationId])
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programs     Program[]
  @@index([organizationId])
}

model Program {
  id                 String           @id @default(cuid())
  organizationId     String
  campusId           String?
  departmentId       String?
  formDefinitionId   String?
  title              String
  slug               String
  category           ProgramCategory  @default(YOUNG_POST_GRADUATE)
  degreeLevel        DegreeLevel      @default(BACHELORS)
  description        String?
  eligibilitySummary String?
  imageUrl           String?
  price              Float?
  tuitionCurrency    String           @default("USD")
  capacity           Int?
  applicationFee     Float?
  requiredDocs       String           @default("[]")
  crmCatalogId       String?
  requiresCrmCallback Boolean         @default(false)
  status             ProgramStatus    @default(DRAFT)
  // Compass Course / FoundationProgram
  programKind        ProgramKind      @default(COURSE)
  sku                String?
  isInventoryOnly    Boolean          @default(false)
  batchId            String?
  domainSlug         String?
  domain             String?          @default("undergraduate")
  duration           String?
  originalPrice      Float?
  level              CourseLevel?
  learningOutcomes   String[]         @default([])
  pricing            Json?
  tags               String[]         @default([])
  type               CourseType?
  weeks              Int?
  batchStartDate     DateTime?
  isHybridOnly       Boolean          @default(false)
  publishedAt        DateTime?
  lastDraftSave      DateTime?
  curriculum         Json?
  draftCurriculum    Json?
  certificateTemplateId String?
  specialization     String?
  location           String?
  brochureUrl        String?
  requiresEntranceExam Boolean        @default(false)
  durationYears      Int?
  semestersPerYear   Int?
  cautionDeposit     Float?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus?         @relation(fields: [campusId], references: [id])
  department     Department?     @relation(fields: [departmentId], references: [id])
  formDefinition FormDefinition? @relation(fields: [formDefinitionId], references: [id])
  certificateTemplate CertificateTemplate? @relation(fields: [certificateTemplateId], references: [id])
  intakes        Intake[]
  applications   Application[]
  enrollments    Enrollment[]
  assignments    Assignment[]
  quizzes        Quiz[]
  certificates   Certificate[]
  syllabus       ProgramSyllabus?
  forumThreads   ForumThread[]
  courseMcqs     CourseMcq[]
  lessonMcqs     LessonMcq[]
  courseAssessmentAttempts CourseAssessmentAttempt[]
  bloomsAnalyses BloomsAnalysis[]
  coupons        Coupon[]        @relation("ProgramCoupons")
  payments       Payment[]       @relation("ProgramPayments")
  programOffers  ProgramOffer[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([organizationId, category])
}

model Enrollment {
  id             String           @id @default(cuid())
  organizationId String
  programId      String
  userId         String
  status         EnrollmentStatus @default(PENDING)
  enrolledAt     DateTime?
  crmLeadId      String?
  crmRequestedAt DateTime?
  crmCallbackAt  DateTime?
  // Compass
  foundationProgramId String?
  progress       Json?
  lessonAccessTimes Json?
  totalLearningMinutes Int        @default(0)
  lastAccessedAt DateTime?
  lastModuleIndex Int?
  lastLessonIndex Int?
  completedAt    DateTime?
  amountPaid     Float            @default(0)
  unlockedPercentage Int          @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program      Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments     Payment[]
  crmSyncLogs  CrmSyncLog[]

  @@unique([userId, programId])
  @@index([organizationId, status])
  @@index([programId])
  @@index([userId])
  @@index([crmLeadId])
}

model ProgramSyllabus {
  id          String         @id @default(cuid())
  programId   String         @unique
  title       String?
  description String?
  status      SyllabusStatus @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  program Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  modules SyllabusModule[]
}

model SyllabusModule {
  id         String   @id @default(cuid())
  syllabusId String
  title      String
  summary    String?
  order      Int      @default(0)
  // Compass Module
  slug       String?
  isLocked   Boolean  @default(false)
  goal       String?
  duration   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  syllabus ProgramSyllabus  @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  lessons  SyllabusLesson[]
  @@index([syllabusId, order])
}

model SyllabusLesson {
  id          String            @id @default(cuid())
  moduleId    String
  title       String
  summary     String?
  contentType LessonContentType @default(RICH_TEXT)
  content     String            @default("")
  durationMin Int?
  order       Int               @default(0)
  isPublished Boolean           @default(true)
  // Compass Lesson
  slug        String?
  type        LessonType?
  videoUrl    String?
  duration    String?
  isFree      Boolean           @default(false)
  isPreview   Boolean           @default(false)
  audioUrl    String?
  subtitleUrl String?
  passingScore Int              @default(0)
  quizConfig  Json?
  assignmentConfig Json?
  resources   Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  module   SyllabusModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress LessonProgress[]
  assignmentSubmissions AssignmentSubmission[]
  lessonMcqs LessonMcq[]
  @@index([moduleId, order])
}

model LessonProgress {
  id          String    @id @default(cuid())
  lessonId    String
  userId      String
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lesson SyllabusLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([lessonId, userId])
  @@index([userId])
}

model Intake {
  id               String    @id @default(cuid())
  programId        String
  name             String
  startDate        DateTime?
  applicationOpen  DateTime?
  applicationClose DateTime?
  capacity         Int?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  program      Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  applications Application[]
  @@index([programId])
}

model FormDefinition {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     FormVersion[]
  programs     Program[]
  @@index([organizationId])
}

model FormVersion {
  id               String   @id @default(cuid())
  formDefinitionId String
  version          Int
  schemaJson       String
  isPublished      Boolean  @default(false)
  publishedAt      DateTime?
  createdAt        DateTime @default(now())
  formDefinition FormDefinition @relation(fields: [formDefinitionId], references: [id], onDelete: Cascade)
  applications   Application[]
  @@unique([formDefinitionId, version])
}

model Application {
  id               String            @id @default(cuid())
  organizationId   String
  programId        String
  intakeId         String?
  applicantId      String
  formVersionId    String
  status           ApplicationStatus @default(DRAFT)
  answersJson      String            @default("{}")
  crmLeadId        String?
  crmApplicationId String?
  submittedAt      DateTime?
  // Compass AdmissionApplication
  referenceNumber  String?
  lastSavedStep    Int               @default(0)
  paymentPlan      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program      Program      @relation(fields: [programId], references: [id])
  intake       Intake?      @relation(fields: [intakeId], references: [id])
  applicant    User         @relation("ApplicantApplications", fields: [applicantId], references: [id])
  formVersion  FormVersion  @relation(fields: [formVersionId], references: [id])
  events       ApplicationEvent[]
  documents    Document[]
  crmSyncLogs  CrmSyncLog[]
  payments     Payment[]
  @@index([organizationId, status])
  @@index([applicantId])
  @@index([programId])
}

model Payment {
  id                String          @id @default(cuid())
  organizationId    String
  applicationId     String?
  enrollmentId      String?
  amount            Float
  currency          String          @default("INR")
  status            PaymentStatus   @default(CREATED)
  provider          PaymentProvider @default(MOCK)
  purpose           String          @default("APPLICATION_FEE")
  providerOrderId   String?
  providerPaymentId String?
  providerSignature String?
  receiptUrl        String?
  failureReason     String?
  paymentDate       DateTime?
  metadataJson      String          @default("{}")
  // Compass Transaction
  invoiceId         String?
  idempotencyKey    String?
  userId            String?
  paymentType       PaymentType?
  totalAmount       Float?
  paidAmount        Float?
  dueAmount         Float?
  nextPaymentDate   DateTime?
  utr               String?
  expiresAt         DateTime?
  couponCode        String?
  discountAmount    Float           @default(0)
  paymentPlan       String?
  refundDetails     Json?
  installmentId     String?
  adminNotes        String?
  convenienceFee    Float           @default(0)
  gstAmount         Float?
  paymentProofUrl   String?
  principalAmount   Float?
  totalPaid         Float?
  userSubmittedUtr  String?
  programId         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application  Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  enrollment   Enrollment?  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user         User?        @relation("PaymentUser", fields: [userId], references: [id])
  installment  Installment? @relation(fields: [installmentId], references: [id])
  program      Program?     @relation("ProgramPayments", fields: [programId], references: [id])
  tickets      Ticket[]

  @@index([applicationId])
  @@index([enrollmentId])
  @@index([organizationId, status])
  @@index([providerOrderId])
  @@index([invoiceId])
  @@index([userId])
}

model ApplicationEvent {
  id            String            @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  note          String?
  actorId       String?
  createdAt     DateTime          @default(now())
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User?       @relation(fields: [actorId], references: [id])
  @@index([applicationId])
}

model Document {
  id            String    @id @default(cuid())
  applicationId String
  fieldKey      String
  fileName      String
  mimeType      String
  sizeBytes     Int
  storagePath   String
  uploadedById  String
  verifiedAt    DateTime?
  verifiedById  String?
  createdAt     DateTime  @default(now())
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  uploadedBy  User        @relation(fields: [uploadedById], references: [id])
  verifiedBy  User?       @relation("DocumentVerifier", fields: [verifiedById], references: [id])
  @@index([applicationId])
}

model CrmSyncLog {
  id             String        @id @default(cuid())
  organizationId String
  applicationId  String?
  enrollmentId   String?
  action         CrmSyncAction
  status         CrmSyncStatus
  requestJson    String?
  responseJson   String?
  errorMessage   String?
  createdAt      DateTime      @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application  Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  enrollment   Enrollment?  @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  @@index([organizationId])
  @@index([applicationId])
  @@index([enrollmentId])
}

model Assignment {
  id             String   @id @default(cuid())
  organizationId String
  programId      String
  title          String
  description    String   @default("")
  dueAt          DateTime?
  isPublished    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program      Program                @relation(fields: [programId], references: [id], onDelete: Cascade)
  submissions  AssignmentSubmission[]
  @@index([programId])
  @@index([organizationId])
}

model AssignmentSubmission {
  id           String                     @id @default(cuid())
  assignmentId String?
  userId       String
  contentBody  String                     @default("")
  status       AssignmentSubmissionStatus @default(DRAFT)
  submittedAt  DateTime?
  // Compass
  lessonId     String?
  programId    String?
  fileUrl      String?
  fileName     String?
  fileSize     Int?
  textAnswer   String?
  grade        Float?
  feedback     String?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson     SyllabusLesson? @relation(fields: [lessonId], references: [id])
  @@index([userId])
  @@index([lessonId])
  @@index([assignmentId, userId])
}

model Certificate {
  id              String            @id @default(cuid())
  organizationId  String
  programId       String
  userId          String
  title           String
  certificateId   String            @unique
  issueDate       DateTime          @default(now())
  status          CertificateStatus @default(ACTIVE)
  grade           String?
  metadata        Json?
  certificateTemplateId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program      Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
