# EDITH PostgreSQL (do NOT point at compass_dev)
# Bundled docker-compose Postgres listens on 5439, not 5432.
#   from the host      -> postgresql://postgres:postgres@localhost:5439/edith_dev?schema=public
#   from the container  -> postgresql://postgres:postgres@postgres:5439/edith_dev?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5439/edith_dev?schema=public"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
# The app serves UI and /api on 3059 in dev and in Docker.
AUTH_URL="http://localhost:3059"
NEXTAUTH_URL="http://localhost:3059"

# Registration
ALLOW_PUBLIC_REGISTRATION="true"
DEFAULT_ORG_SLUG="the-foundrys"

# CentraCRM (https://dev-crm.thefoundrys.com/api-docs/)
CRM_ADAPTER="centracrm"
CRM_BASE_URL="https://dev-crm.thefoundrys.com/api/v1"
CRM_TENANT_ID=""
CRM_DEFAULT_CATALOG_ID=""
# Shared secret for POST /api/crm/enrollment-callback
# CRM_WEBHOOK_SECRET=
# CRM_EMAIL=
# CRM_PASSWORD=

# Payments — course enrollment fee (and legacy application fee)
# Local/dev: mock (default when PAYMENT_ADAPTER unset and NODE_ENV !== production)
# Production: defaults to razorpay; mock is blocked unless ALLOW_MOCK_PAYMENTS=true
PAYMENT_ADAPTER="mock"
# ALLOW_MOCK_PAYMENTS="true"   # emergency / approved non-prod only — never in real prod
# For live/test Razorpay Checkout.js + order API:
# PAYMENT_ADAPTER="razorpay"
# RAZORPAY_KEY_ID="rzp_test_..."
# RAZORPAY_KEY_SECRET="..."
# Webhook (optional backup): POST /api/payments/razorpay/webhook
# Enable payment.captured + payment.failed in the Razorpay dashboard.
# RAZORPAY_WEBHOOK_SECRET="..."
