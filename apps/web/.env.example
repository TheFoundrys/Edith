# PostgreSQL — Edith Prisma schema (Program, Membership, …).
#
# Shared LAN dev (no local Docker Postgres):
#   postgresql://postgres:PASSWORD@192.168.1.3:5432/compass_dev?schema=public
#
# Bundled docker-compose Postgres listens on 5439, not 5432:
#   from the host      -> postgresql://postgres:postgres@localhost:5439/edith_dev?schema=public
#   from the container -> postgresql://postgres:postgres@postgres:5439/edith_dev?schema=public
#
# Do not run prisma migrate / db push against compass_dev unless explicitly approved.
# When using compass_dev, DEFAULT_ORG_SLUG should match a Domain slug (ai, cyber-security, …).
DATABASE_URL="postgresql://postgres:postgres@localhost:5439/edith_dev?schema=public"
# DB_PROFILE="compass"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
# The app serves UI and /api on 3059 in dev and in Docker.
SITE_URL="http://localhost:3059"
AUTH_URL="http://localhost:3059"
NEXTAUTH_URL="http://localhost:3059"

# Transactional email (password recovery)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Edith <no-reply@your-domain.com>"

# Encrypts per-organization AI provider credentials at rest.
# Generate with: openssl rand -base64 32
# AI_CONFIG_ENCRYPTION_KEY=""

# OptGPT / Ollama (OpenAI-compatible chat API) — optional server defaults.
# Used when Admin → AI plugins has no complete openai-compatible config saved.
# Base URL is normalized to …/v1 for /chat/completions.
# OPTGPT_URL="http://192.168.1.117:8006"
# MODEL_NAME="optgpt:7b"
# OLLAMA_API_KEY="ollama"
# Aliases: OLLAMA_BASE_URL, OLLAMA_MODEL, OPTGPT_MODEL

# Registration
ALLOW_PUBLIC_REGISTRATION="true"
DEFAULT_ORG_SLUG="the-foundrys"

# CentraCRM (https://dev-crm.thefoundrys.com/api-docs/)
CRM_ADAPTER="centracrm"
CRM_BASE_URL="https://dev-crm.thefoundrys.com/api/v1"
# Browser origin for application redirects. Defaults to CRM_BASE_URL without /api/v1.
# CRM_APP_URL="https://dev-crm.thefoundrys.com"
CRM_TENANT_ID=""
CRM_DEFAULT_CATALOG_ID=""
# Shared secret for POST /api/crm/enrollment-callback
# CRM_WEBHOOK_SECRET=
# CRM_EMAIL=
# CRM_PASSWORD=

# Payments — course enrollment fee (and legacy application fee)
# Local/dev: mock (default when PAYMENT_ADAPTER unset and NODE_ENV !== production)
# Production: defaults to razorpay; mock is blocked unless ALLOW_MOCK_PAYMENTS=true
PAYMENT_ADAPTER="mock"
# ALLOW_MOCK_PAYMENTS="true"   # emergency / approved non-prod only — never in real prod
# For live/test Razorpay Checkout.js + order API:
# PAYMENT_ADAPTER="razorpay"
# RAZORPAY_KEY_ID="rzp_test_..."
# RAZORPAY_KEY_SECRET="..."
# For Stripe Checkout redirect:
# PAYMENT_ADAPTER="stripe"
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# Webhook (optional backup): POST /api/payments/razorpay/webhook
# Enable payment.captured + payment.failed in the Razorpay dashboard.
# RAZORPAY_WEBHOOK_SECRET="..."

# DigiLocker (Meri Pehchaan) — optional Aadhaar path for Personality Profile
# Students can always enter a 12-digit Aadhaar (hash + last-four only).
# Leave unset locally; the DigiLocker button is hidden until these are set.
# DIGILOCKER_CLIENT_ID=""
# DIGILOCKER_CLIENT_SECRET=""
# Optional override; default is {AUTH_URL}/api/digilocker/callback
# DIGILOCKER_REDIRECT_URI="https://your-domain/api/digilocker/callback"
# DIGILOCKER_BASE_URL="https://digilocker.meripehchaan.gov.in/public/oauth2"
