# Production environment for apps/web.
#
# Copy this to apps/web/.env ON THE SERVER and fill it in. The deploy never
# overwrites that file, which is why a development .env copied here survives
# every release and quietly breaks things. Every value below differs from dev.

# --- Database ---------------------------------------------------------------
# The production database. Not a LAN address from someone's laptop: the app,
# the `migrate` service and `publish-catalog` all follow this one URL, so a dev
# value here means content and migrations land in the wrong database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/edith?schema=public"

# --- Auth -------------------------------------------------------------------
# The public origin users actually type, scheme included, no trailing slash.
# NextAuth builds its client-side URLs from these. A localhost value makes the
# browser issue cross-origin requests to the visitor's own machine; they fail
# CORS preflight and take the Server Components render down with them.
AUTH_URL="https://your-domain"
NEXTAUTH_URL="https://your-domain"

# Unique to production. Generate with:  openssl rand -base64 32
# Reusing the development secret means a session minted in dev authenticates
# here.
AUTH_SECRET="generate-a-new-one"

# --- Registration -----------------------------------------------------------
ALLOW_PUBLIC_REGISTRATION="true"
# Both the app and publish-catalog resolve the tenant through this slug.
DEFAULT_ORG_SLUG="the-foundrys"

# --- CRM --------------------------------------------------------------------
# Production CentraCRM, not dev-crm: applications sync to whatever is set here.
CRM_ADAPTER="centracrm"
CRM_BASE_URL="https://crm.thefoundrys.com/api/v1"
CRM_TENANT_ID=""
CRM_DEFAULT_CATALOG_ID=""
CRM_EMAIL=""
CRM_PASSWORD=""
CRM_WEBHOOK_SECRET=""

# --- Payments ---------------------------------------------------------------
# The mock adapter throws under NODE_ENV=production (lib/payments/index.ts), so
# a development value here breaks checkout at the first real payment.
PAYMENT_ADAPTER="razorpay"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
