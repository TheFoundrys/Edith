# Compose-level settings, read by Docker Compose itself for ${...} substitution
# in docker-compose.yml. Application configuration lives in apps/web/.env
# (see apps/web/.env.example) — DATABASE_URL, AUTH_SECRET, CRM_*, RAZORPAY_*.

# Public origin of the app. Becomes AUTH_URL / NEXTAUTH_URL; if this is wrong,
# Auth.js builds login callbacks pointing at localhost and sign-in breaks.
APP_ORIGIN="http://localhost:3059"

# Host interface and port for the app. Use 127.0.0.1 when nginx terminates TLS
# in front of it, so the raw port is not exposed.
APP_BIND="0.0.0.0"
APP_PORT="3059"

# Bundled Postgres. Only takes effect the first time the volume is created, and
# must match the credentials in apps/web/.env DATABASE_URL. Left on loopback
# deliberately: published Docker ports bypass ufw.
POSTGRES_BIND="127.0.0.1"
POSTGRES_PORT="5439"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="edith_dev"
