{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@frontend/*": ["src/frontend/*"],
      "@backend/*": ["src/backend/*"],
      "@shared/*": ["src/shared/*"],
      "@api/*": ["api/*"]
    }
  },
  "include": ["src/frontend", "src/shared", "vite.config.ts", "vitest.config.ts"]
}
